# RepoTap — GitHub OAuth App
# Copy this file to .env and fill in the secret from
# https://github.com/settings/applications → RepoTap → Generate a new client secret
#
# The .env file is gitignored and never committed. The secret is inlined
# into the build at compile time only.

# Public — safe to commit (already in src/lib/auth/config.js)
REPOTAP_GITHUB_CLIENT_ID=Ov23limmkJiFpRSpxKtm

# Secret — keep in .env only, never commit
REPOTAP_GITHUB_CLIENT_SECRET=