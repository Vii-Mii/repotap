{
  "manifest_version": 3,
  "name": "RepoTap",
  "version": "1.0.0",
  "description": "Commit LeetCode, HackerRank & GeeksForGeeks accepted solutions to GitHub — structured, annotated, on your terms.",
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://*.leetcode.com/*",
    "https://*.hackerrank.com/*",
    "https://*.geeksforgeeks.org/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "RepoTap"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.leetcode.com/*",
        "https://*.hackerrank.com/*"
      ],
      "js": ["content/page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.geeksforgeeks.org/*"],
      "js": ["content/page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://*.leetcode.com/*"],
      "js": ["content/leetcode.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.hackerrank.com/*"],
      "js": ["content/hackerrank.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.geeksforgeeks.org/*"],
      "js": ["content/geeksforgeeks.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
